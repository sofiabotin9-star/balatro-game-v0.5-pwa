{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "私人小丑牌",
  "version": "0.4.0",
  "identifier": "com.private.jokerpoker.p71ee2bac",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "私人小丑牌",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com https://api.deepseek.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "私人离线扑克肉鸽卡牌游戏",
    "longDescription": "为个人 iPhone 单机游玩准备的离线扑克肉鸽卡牌游戏。核心游戏、资源和存档均可本地运行。",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
